# ==============================================================================
# SmartSpace Backend Environment Configuration (.env.example)
# Copy this file to SmartSpace_Backend/.env and fill in real values.
# NEVER commit real secrets to version control.
# ==============================================================================

# --- Database (MySQL) ---
DB_PASSWORD=your_mysql_password

# --- Redis ---
REDIS_URL=redis://localhost:6379

# --- JWT Security ---
JWT_SIGNER_KEY=replace_with_a_strong_64_byte_base64_or_hex_secret_key

# --- Google OAuth2 ---
GOOGLE_CLIENT_ID=your_google_oauth_client_id
GOOGLE_CLIENT_SECRET=your_google_oauth_client_secret
GOOGLE_REDIRECT_URI=http://localhost:8989/login/oauth2/code/google

# --- Cloudinary Media Storage ---
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# --- Mail (Gmail SMTP) ---
MAIL_USERNAME=your_email@gmail.com
MAIL_PASSWORD=your_app_password
MAIL_FROM_NAME=SmartSpace
MAIL_LOGO_URL=
MAIL_STAFF_APP_URL=
MAIL_ADMIN_PORTAL_URL=
MAIL_SUPPORT_EMAIL=

# --- WebRTC Audio Call (Academic / Dev Config) ---
# Free public STUN servers for P2P audio calls (no account or API key required).
WEBRTC_STUN_URLS=stun:stun.l.google.com:19302,stun:stun1.l.google.com:19302
# Use stun_only for local/Wi-Fi dev & demo (TURN credentials & call timeouts use safe defaults in application.yaml).
WEBRTC_TURN_MODE=stun_only
